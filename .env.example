# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
# URL da Developer Platform (documentation/). GET /docs redireciona para ela.
DOCS_URL=

# Database (DIRECT_URL = conexão direta, usada pelo Prisma em migrations quando DATABASE_URL usa pooler)
DATABASE_URL=postgresql://user:password@localhost:5432/apasbac
DIRECT_URL=postgresql://user:password@localhost:5432/apasbac

# JWT — use valores longos e aleatórios, diferentes entre si (ex.: openssl rand -base64 48)
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# CORS — origens de navegador permitidas, separadas por vírgula. Vazio = qualquer origem
# (a API usa Bearer token, não cookies; CORS não é autenticação).
CORS_ORIGINS=

# Cloudinary (armazenamento de fotos, vídeos e QR Codes)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Nodemailer (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="APASBAC <noreply@apasbac.org.br>"

# Google Sheets (Service Account JSON key)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id

# Rate limiting global (rotas de autenticação têm limites próprios, mais baixos)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Seed — admin inicial. Em produção não há senha padrão: sem SEED_ADMIN_PASSWORD o admin não é criado.
SEED_ADMIN_EMAIL=admin@apasbac.org.br
SEED_ADMIN_PASSWORD=

# ──────────────────────────────────────────────────────────────────────────
# NOTA: O telefone e e-mail de contato da APASBAC NÃO ficam aqui.
# Configure-os pelo painel Admin após subir a API:
#   PATCH /api/v1/configs/apasbac_phone  { "value": "+55 44 9XXXX-XXXX" }
#   PATCH /api/v1/configs/apasbac_email  { "value": "contato@apasbac.org.br" }
# ──────────────────────────────────────────────────────────────────────────
